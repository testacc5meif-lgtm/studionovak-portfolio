---
import site from '../data/site.json';

const steps = [
  { time: '07:00:02', text: 'Fetched invoices_week41.pdf' },
  { time: '07:00:04', text: 'Extracted 48 line items' },
  { time: '07:00:05', text: 'Updated orders.xlsx' },
  { time: '07:00:06', text: 'Flagged 2 unpaid invoices' },
  { time: '07:00:07', text: 'Emailed summary to the team' },
];
---

<section class="hero" id="top">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Available for new projects · {site.location}
      </p>

      <h1>
        I build simple web apps that <span class="hl">save you time</span>
      </h1>

      <p class="lead">
        Hi, I'm {site.name.split(' ')[0]}. I help small businesses get rid of repetitive work with small,
        reliable tools and automations, built around how you already work.
      </p>

      <div class="hero-ctas">
        <a href="#work" class="btn btn-primary">
          See my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="#contact" class="btn btn-ghost">Contact me</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="log">
        <div class="log-bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="log-title">automation.log</span>
          <span class="log-badge">running</span>
        </div>
        <ol class="log-lines">
          {
            steps.map((s, i) => (
              <li style={`--i:${i}`}>
                <span class="check">✓</span>
                <span class="t">{s.time}</span>
                <span class="msg">{s.text}</span>
              </li>
            ))
          }
        </ol>
        <div class="log-foot">
          <span>Manual work today</span>
          <strong>0 min</strong>
        </div>
      </div>
      <div class="sticker">
        <span>while you<br />sleep</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 9vw, 112px) clamp(72px, 10vw, 128px);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--bg-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(48px, 7vw, 72px);
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  h1 {
    font-size: clamp(2.6rem, 8.4vw, 5.4rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 13ch;
  }

  .hl {
    position: relative;
    white-space: nowrap;
    color: var(--accent);
  }

  .hl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.04em;
    height: 0.14em;
    background: currentColor;
    border-radius: 99px;
    opacity: 0.28;
    transform-origin: left;
    animation: underline 0.9s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes underline {
    from {
      transform: scaleX(0);
    }
  }

  .lead {
    margin-top: 24px;
    max-width: 34rem;
    font-size: clamp(1.075rem, 1.6vw, 1.25rem);
    color: var(--muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* ---- log card ---- */
  .hero-visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 460px;
  }

  .log {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    overflow: hidden;
  }

  .log-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }

  .log-title {
    color: var(--muted);
  }

  .log-badge {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.72rem;
  }

  .log-lines {
    list-style: none;
    margin: 0;
    padding: 14px 16px 8px;
    display: grid;
    gap: 4px;
  }

  .log-lines li {
    display: grid;
    grid-template-columns: 18px auto 1fr;
    gap: 10px;
    align-items: baseline;
    padding: 7px 0;
    border-bottom: 1px dashed var(--line);
    opacity: 0;
    animation: line-in 0.45s calc(0.5s + var(--i) * 0.38s) ease-out forwards;
  }

  .log-lines li:last-child {
    border-bottom: 0;
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .check {
    color: var(--ok);
    font-weight: 700;
  }

  .t {
    color: var(--muted);
  }

  .msg {
    color: var(--ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .log-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: var(--surface-2);
    color: var(--muted);
  }

  .log-foot strong {
    color: var(--ink);
    font-size: 1rem;
  }

  .sticker {
    position: absolute;
    top: -26px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1.1;
    text-align: center;
    transform: rotate(12deg);
    box-shadow: var(--shadow);
    animation: wobble 6s ease-in-out infinite;
  }

  @keyframes wobble {
    50% {
      transform: rotate(4deg) translateY(-4px);
    }
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hero-visual {
      justify-self: end;
    }
  }

  @media (max-width: 420px) {
    .t {
      display: none;
    }

    .log-lines li {
      grid-template-columns: 18px 1fr;
    }

    .sticker {
      width: 78px;
      height: 78px;
      font-size: 0.75rem;
      right: -4px;
    }
  }
</style>
