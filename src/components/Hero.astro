---
import site from '../data/site.json';

// The real Jelovnik app pipeline (see the project card further down)
const steps = [
  { tag: 'pdf', text: 'Picks up the new meal schedule PDF' },
  { tag: 'ocr', text: 'Reads the menu with Tesseract OCR' },
  { tag: 'db', text: 'Saves it to Supabase Postgres' },
  { tag: 'push', text: "Sends today's menu to students' phones" },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Available for new projects · {site.location}
      </p>

      <h1 id="hero-title">
        I build simple web apps that <span class="hl"
          >save you time<svg class="squiggle" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M3 9.5C45 3 78 12.5 120 7s82-5 120 1 48 2 57-3"></path></svg
          ></span
        >
      </h1>

      <p class="lead">
        I'm {site.name.split(' ')[0]}, a developer from {site.location}. I take the repetitive parts of running a small
        business, like PDFs, spreadsheets and copy-pasting between apps, and turn them into simple tools that run on
        their own.
      </p>

      <div class="hero-ctas">
        <a href="#work" class="btn btn-primary">
          See my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="#contact" class="btn btn-ghost">Contact me</a>
      </div>
    </div>

    <figure class="hero-visual">
      <div class="log">
        <div class="log-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="log-title">jelovnik-app</span>
          <span class="log-badge">live</span>
        </div>
        <ol class="log-lines" aria-label="What Jelovnik app does automatically">
          {
            steps.map((s, i) => (
              <li style={`--i:${i}`}>
                <svg class="check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8.5l3.2 3L13 4.5" />
                </svg>
                <span class="tag" aria-hidden="true">{s.tag}</span>
                <span class="msg">{s.text}</span>
              </li>
            ))
          }
        </ol>
        <dl class="log-foot">
          <div>
            <dt>Manual work</dt>
            <dd>0 min</dd>
          </div>
          <div>
            <dt>Hosting cost</dt>
            <dd>Free</dd>
          </div>
        </dl>
      </div>
      <figcaption>
        <a href="#work">The real pipeline behind my Jelovnik app <span aria-hidden="true">↓</span></a>
      </figcaption>
      <div class="sticker" aria-hidden="true">
        <span>runs on<br />its own</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 8vw, 104px) clamp(64px, 9vw, 120px);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--bg-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(56px, 7vw, 72px);
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  h1 {
    font-size: clamp(2.6rem, 8.4vw, 5.4rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 13ch;
  }

  .hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    color: var(--accent);
  }

  .squiggle {
    position: absolute;
    left: 0;
    width: 100%;
    bottom: -0.2em;
    height: 0.22em;
    overflow: visible;
    /* Wipe in with a clip rather than a stroke-dash trick: dash lengths don't
       line up with pathLength once the SVG is stretched + non-scaling-stroke */
    clip-path: inset(-50% 100% -50% 0);
    animation: draw 0.9s 0.4s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }

  .squiggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @keyframes draw {
    to {
      clip-path: inset(-50% -2% -50% 0);
    }
  }

  .lead {
    margin-top: 32px;
    max-width: 34rem;
    font-size: clamp(1.075rem, 1.6vw, 1.25rem);
    color: var(--muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* ---- pipeline card ---- */
  .hero-visual {
    position: relative;
    margin: 0;
    justify-self: center;
    width: 100%;
    max-width: 480px;
  }

  .log {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    overflow: hidden;
  }

  .log-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }

  .log-title {
    color: var(--muted);
  }

  .log-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
    font-size: 0.72rem;
  }

  .log-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .log-lines {
    list-style: none;
    margin: 0;
    padding: 10px 16px;
  }

  .log-lines li {
    display: grid;
    grid-template-columns: 16px 3.6em 1fr;
    gap: 10px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px dashed var(--line);
    opacity: 0;
    animation: line-in 0.45s calc(0.5s + var(--i) * 0.4s) ease-out forwards;
  }

  .log-lines li:last-child {
    border-bottom: 0;
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .check {
    width: 16px;
    height: 16px;
    color: var(--ok);
  }

  .tag {
    justify-self: start;
    padding: 1px 7px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .msg {
    color: var(--ink);
    min-width: 0;
  }

  .log-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    background: var(--surface-2);
  }

  .log-foot div {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
  }

  .log-foot div + div {
    border-left: 1px solid var(--line);
  }

  .log-foot dt {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .log-foot dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  figcaption {
    margin-top: 14px;
    text-align: center;
    font-size: 0.925rem;
  }

  figcaption a {
    display: inline-block;
    padding: 6px 4px;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  figcaption a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  .sticker {
    position: absolute;
    top: -30px;
    right: -12px;
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1.1;
    text-align: center;
    transform: rotate(12deg);
    box-shadow: var(--shadow);
    animation: wobble 6s ease-in-out infinite;
  }

  @keyframes wobble {
    50% {
      transform: rotate(4deg) translateY(-4px);
    }
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hero-visual {
      justify-self: end;
    }
  }

  @media (max-width: 420px) {
    .hero-ctas .btn {
      flex: 1 1 auto;
    }

    .log-lines li {
      grid-template-columns: 16px 1fr;
    }

    .tag {
      display: none;
    }

    .sticker {
      width: 76px;
      height: 76px;
      font-size: 0.72rem;
      top: -26px;
      right: -4px;
    }
  }
</style>
