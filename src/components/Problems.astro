---
const problems = [
  {
    title: 'Automating repetitive tasks',
    text: 'Copying data between apps, sending the same emails, checking the same page every morning. If you do it on repeat, a script can do it for you.',
    example: 'Daily reports, reminders, data sync',
    icon: 'repeat',
  },
  {
    title: 'Custom internal tools',
    text: 'A simple app built around how your team actually works, instead of bending your process to fit yet another subscription.',
    example: 'Order trackers, dashboards, booking forms',
    icon: 'tool',
  },
  {
    title: 'Processing PDFs & spreadsheets',
    text: 'Pull data out of PDFs, scans and Excel files automatically, clean it up and put it where it belongs. No more retyping.',
    example: 'Invoices, schedules, price lists',
    icon: 'doc',
  },
  {
    title: 'Fixing existing apps',
    text: 'Something broke, got slow or never quite worked? I dig into existing code, find the issue and fix it without a full rewrite.',
    example: 'Bugs, slow pages, broken integrations',
    icon: 'fix',
  },
];

const icons: Record<string, string> = {
  repeat: '<path d="M17 2l4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  tool: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M17.5 14v7M14 17.5h7"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
  fix: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
};
---

<section class="section problems" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><span class="num">01</span> Problems I solve</span>
      <h2 id="services-title">Small tools that give you hours back</h2>
      <p>No giant platforms and no endless meetings. I find the boring, manual part of your week and replace it with something that just works.</p>
    </div>

    <ul class="cards">
      {
        problems.map((p, i) => (
          <li class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <div class="card-top">
              <span class="icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon]} />
              </span>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <p class="example">{p.example}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problems {
    border-top: 1px solid var(--line);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .card:hover .icon {
    transform: rotate(-8deg) scale(1.05);
  }

  .icon svg {
    width: 24px;
    height: 24px;
  }

  .idx {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .card p {
    color: var(--muted);
  }

  .card .example {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
  }

  @media (min-width: 680px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }

    .card {
      padding: 24px;
    }

    .card p {
      font-size: 0.975rem;
    }
  }
</style>
