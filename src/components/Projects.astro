---
import projectsData from '../data/projects.json';

interface Project {
  name: string;
  tagline?: string;
  problem: string;
  solution: string;
  result: string;
  stack: string[];
  link?: string;
}

const projects = projectsData as Project[];

const host = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<section class="section work" id="work">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><span class="num">02</span> Selected work</span>
      <h2>Real problems, solved for good</h2>
      <p>Every project starts with something annoying and ends with it running on its own.</p>
    </div>

    <div class="projects">
      {
        projects.map((p, i) => (
          <article class="project" data-reveal>
            <header class="project-head">
              <div>
                <span class="project-idx">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.name}</h3>
                {p.tagline && <p class="tagline">{p.tagline}</p>}
              </div>
              {p.link && (
                <a class="visit" href={p.link} target="_blank" rel="noopener noreferrer">
                  <span>{host(p.link)}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M8 7h9v9" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )}
            </header>

            <ol class="flow">
              <li class="step">
                <span class="step-label">Problem</span>
                <p>{p.problem}</p>
              </li>
              <li class="arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </li>
              <li class="step">
                <span class="step-label">Solution</span>
                <p>{p.solution}</p>
              </li>
              <li class="arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </li>
              <li class="step step-result">
                <span class="step-label">Result</span>
                <p>{p.result}</p>
              </li>
            </ol>

            <footer class="project-foot">
              <span class="stack-label">Stack</span>
              <ul class="stack">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </footer>
          </article>
        ))
      }

      <a href="#contact" class="next" data-reveal>
        <span class="next-plus" aria-hidden="true">+</span>
        <span>
          <strong>Your project could be next</strong>
          <span class="next-sub">Tell me what eats up your time and I'll tell you if it can be automated.</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }

  .projects {
    display: grid;
    gap: 20px;
  }

  .project {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 4vw, 40px);
    box-shadow: var(--shadow);
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  .project-idx {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  h3 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-top: 6px;
  }

  .tagline {
    margin-top: 8px;
    color: var(--muted);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding-inline: 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    max-width: 100%;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .visit span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .visit svg {
    flex: none;
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .visit:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .visit:hover svg {
    transform: translate(2px, -2px);
  }

  /* Problem → Solution → Result */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .step {
    position: relative;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .step-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .step p {
    font-size: 1rem;
  }

  .step-result {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .step-result .step-label {
    color: var(--accent);
  }

  .step-result p {
    font-weight: 600;
  }

  .arrow {
    display: grid;
    place-items: center;
    color: var(--accent);
  }

  .arrow svg {
    width: 20px;
    height: 20px;
    transform: rotate(90deg);
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: clamp(22px, 3vw, 30px);
    padding-top: 22px;
    border-top: 1px dashed var(--line);
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack li {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  /* Placeholder card */
  .next {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px clamp(22px, 4vw, 40px);
    border: 1.5px dashed var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, opacity 0.7s ease, transform 0.7s ease;
  }

  .next:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .next-plus {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 1.6rem;
    line-height: 1;
    padding-bottom: 3px;
    transition: transform 0.3s ease, background-color 0.2s ease;
  }

  .next:hover .next-plus {
    transform: rotate(90deg);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .next strong {
    display: block;
    font-size: 1.2rem;
  }

  .next-sub {
    display: block;
    color: var(--muted);
    font-size: 0.975rem;
  }

  @media (min-width: 900px) {
    .flow {
      grid-template-columns: 1fr 36px 1fr 36px 1fr;
      gap: 0;
    }

    .arrow svg {
      transform: none;
    }
  }
</style>
