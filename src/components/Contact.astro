---
import site from '../data/site.json';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel" data-reveal>
      <span class="eyebrow"><span class="num">04</span> Contact</span>
      <h2 id="contact-title">Got a task that eats up your time?</h2>
      <p class="sub">
        Send me a few lines about what's slowing you down: what you do today, how often, and which tools are
        involved. I'll get back to you with an honest take on whether (and how) it can be fixed.
      </p>

      <div class="links">
        <div class="link-card">
          <a class="link-main" href={mailto}>
            <span class="link-label">Email</span>
            <span class="link-value">{site.email}</span>
          </a>
          <button type="button" class="copy" data-copy={site.email}>
            Copy<span class="sr-only"> email address</span>
          </button>
        </div>

        <a class="link-card link-main" href={site.upwork} target="_blank" rel="noopener noreferrer">
          <span class="link-label">Upwork</span>
          <span class="link-value">Hire me on Upwork</span>
          <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M8 7h9v9"></path>
          </svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
      <p class="sr-only" role="status" data-copy-status></p>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <span>© {new Date().getFullYear()} {site.name} · studionovak.com</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const original = btn.innerHTML;
    let timer: ReturnType<typeof setTimeout> | undefined;

    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      let message: string;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Copied!';
        message = 'Email address copied to clipboard';
      } catch {
        btn.textContent = 'Copy failed';
        message = `Could not copy. The email address is ${value}`;
      }
      if (status) status.textContent = message;
      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.innerHTML = original;
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 6vw, 72px);
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--ink);
    color: var(--bg);
    /* The panel inverts the page colours, so small accent text needs the inverse shade */
    --accent-text: var(--accent-text-on-ink);
  }

  .panel :focus-visible {
    outline-color: currentColor;
  }

  .panel::after {
    --size: clamp(240px, 32vw, 420px);
    content: '';
    position: absolute;
    width: var(--size);
    height: var(--size);
    right: calc(var(--size) * -0.33);
    top: calc(var(--size) * -0.38);
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.9;
    pointer-events: none;
  }

  .panel > * {
    position: relative;
    z-index: 1;
  }

  .panel .eyebrow {
    color: color-mix(in srgb, var(--bg) 65%, transparent);
  }

  .panel .eyebrow::after {
    background: color-mix(in srgb, var(--bg) 25%, transparent);
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(2.1rem, 6vw, 4.2rem);
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .sub {
    margin-top: 20px;
    max-width: 36rem;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .links {
    display: grid;
    gap: 12px;
    margin-top: 40px;
  }

  .link-card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--bg) 18%, transparent);
    background: color-mix(in srgb, var(--bg) 6%, transparent);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .link-card:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--bg) 10%, transparent);
  }

  .link-main {
    display: grid;
    gap: 2px;
    /* When the address no longer fits beside the Copy button, the button wraps
       below instead of the address breaking mid-word */
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
  }

  a.link-card.link-main {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: center;
  }

  a.link-card .link-label,
  a.link-card .link-value {
    grid-column: 1;
  }

  .ext {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 20px;
    height: 20px;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .link-card:hover .ext {
    transform: translate(2px, -2px);
  }

  .link-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bg) 68%, transparent);
  }

  .link-value {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .copy {
    flex: none;
    height: 44px;
    padding-inline: 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bg) 25%, transparent);
    background: transparent;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .copy:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .footer {
    padding-block: 28px 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }

  .footer a {
    display: inline-block;
    padding: 10px 0;
    margin-block: -10px;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
